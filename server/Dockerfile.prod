# Production Dockerfile for Backend API
# Multi-stage build for optimized image size

# Stage 1: Build
FROM registry.access.redhat.com/ubi8/nodejs-22@sha256:6e340dc525ab46e195fc01369ce44bdb36a3a04412bb96e05d463bcd451fccd8 AS builder

USER root

# Install Oracle Instant Client dependencies and build tools

RUN dnf update -y && dnf install -y \
    libaio \
    wget \
    unzip \
    python3 \
    make \
    gcc-c++

# Download and install Oracle Instant Client
WORKDIR /opt/oracle
RUN wget https://download.oracle.com/otn_software/linux/instantclient/2113000/instantclient-basic-linux.x64-21.13.0.0.0dbru.zip && \
    unzip instantclient-basic-linux.x64-21.13.0.0.0dbru.zip && \
    rm instantclient-basic-linux.x64-21.13.0.0.0dbru.zip && \
    cd instantclient_21_13 && \
    echo /opt/oracle/instantclient_21_13 > /etc/ld.so.conf.d/oracle-instantclient.conf && \
    ldconfig

# Set environment variables for Oracle Instant Client
ENV LD_LIBRARY_PATH=/opt/oracle/instantclient_21_13:$LD_LIBRARY_PATH
ENV PATH=/opt/oracle/instantclient_21_13:$PATH

# Set working directory
WORKDIR /app

# Copy package files
COPY ./server/package.json ./
COPY ./prod-files-for-af/.npmrc ./

# Kopiera in cert
COPY ./prod-files-for-af/ca-bundle.crt ./ca-bundle.crt

# Ett måste för vissa paket som cypress
ENV NODE_EXTRA_CA_CERTS=/app/ca-bundle.crt

# Install dependencies (including dev dependencies for build)
# Note: Using npm install instead of npm ci because this is part of a monorepo workspace
# and doesn't have its own package-lock.json
RUN npm install

# Copy source code and standalone tsconfig
COPY ./server/tsconfig.json ./tsconfig.json
COPY ./server/src ./src

# Build TypeScript to JavaScript
RUN npm run build

# Remove dev dependencies
RUN npm prune --production

# Stage 2: Runtime
FROM registry.access.redhat.com/ubi8/nodejs-22

USER root

# Install Oracle Instant Client dependencies (runtime only)
RUN dnf update -y && dnf install -y \
    libaio \
    && rm -rf /var/cache/dnf/*

# Copy Oracle Instant Client from builder
COPY --from=builder /opt/oracle/instantclient_21_13 /opt/oracle/instantclient_21_13
COPY --from=builder /etc/ld.so.conf.d/oracle-instantclient.conf /etc/ld.so.conf.d/oracle-instantclient.conf

COPY ./prod-files-for-af/ldap.ora /opt/client/instantclient_21_13/network/admin
COPY ./prod-files-for-af/sqlnet.ora /opt/client/instantclient_21_13/network/admin

RUN ldconfig

# Set environment variables
ENV LD_LIBRARY_PATH=/opt/oracle/instantclient_21_13:$LD_LIBRARY_PATH
ENV PATH=/opt/oracle/instantclient_21_13:$PATH
ENV NODE_ENV=production

# Set working directory
WORKDIR /app

# Copy built application and production dependencies
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start production server
CMD ["npm", "start"]
