# Exempelfil för lokala miljövariabler
# Kopiera till .env.local och fyll i egna värden
# Notera att dessa behöver ligga i .gitlab-ci.yml också för att vara tillgängliga på GitLab Pages
# (alternativt om man har tillräckliga rättigheter ska man kunna sätta dem i GitLabs UI för CI/CD-miljövariabler)
VITE_DATABASE_URL="DATABASE_URL_HERE"
VITE_DATABASE_KEY="DATABASE_KEY_HERE"
VITE_REQUIREMENTS_URL="REQUIREMENTS_URL_HERE"
VITE_PREFILL_REQUIREMENTS={[{"description": "Det här är ett exempel på hur man kan ge möjlighet att förifylla specifika krav", "status": "IRRELEVANT", "requirements": "1,2,100,112"}]}
