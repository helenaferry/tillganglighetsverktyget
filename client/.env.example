# =================================================
# Frontend Environment Variables
# =================================================
# Copy this file to .env.local for local development
# All variables prefixed with VITE_ are available in environment

# =================================================
# API CONFIGURATION
# =================================================
# Standalone mode: Set to "true" to use localStorage instead of API/database
# When true, the app runs independently without server/database dependencies
# Useful for quick demos and simpler setup for less tech-savvy users
# Default: false (uses API and database)

VITE_STANDALONE=false

# Example data: Set to "true" to automatically import example reviews/checks on first run
# Only works when VITE_STANDALONE=true
# Only imports if localStorage is empty (won't overwrite existing data)
# Useful for demo purposes to show the app with sample data
# Default: false (no example data)

VITE_USE_EXAMPLE_DATA=false

# Backend API URL
# Development: http://localhost:3000/api (when backend runs locally or in container)
# Production: /api (nginx will proxy to backend)
# Note: Not used when VITE_STANDALONE=true

VITE_API_URL=http://localhost:3000/api

# URL to fetch requirements data
VITE_REQUIREMENTS_URL=/krav.json