# =================================================
# Frontend Environment Variables
# =================================================
# Copy this file to .env.local for local development
# All variables prefixed with VITE_ are available in the frontend code

# =================================================
# API CONFIGURATION
# =================================================
# Backend API URL
# Development: http://localhost:3000/api (when backend runs locally or in container)
# Production: /api (nginx will proxy to backend)
VITE_API_URL=http://localhost:3000/api

# =================================================
# APPLICATION BRANDING
# =================================================
# Application title shown in the UI
VITE_APPLICATION_TITLE="Granska tillgänglighet"

# Logo configuration (JSON format)
# Paths are relative to the public directory
VITE_LOGO='{
    "header": {
        "mobileUrl": "/logoHeaderMobile.svg",
        "desktopUrl": "/logoHeader.svg"
    },
    "footer": {
        "mobileUrl": "/logoFooterMobile.svg",
        "desktopUrl": "/logoFooter.svg"
    }
}'

# =================================================
# REQUIREMENTS CONFIGURATION
# =================================================
# Regulatory framework to use (e.g., "dos", "wcag")
VITE_REGULATORY_FRAMEWORK="dos"

# URL to fetch requirements data
VITE_REQUIREMENTS_URL="REQUIREMENTS_URL_HERE"

# Additional requirements specific to your organization (JSON format)
VITE_REQUIREMENT_ADDITIONS='{
    "heading": "Arbetsförmedlingens tillägg",
    "items": [
        {
            "id": "jtin",
            "text": "Kravet är uppfyllt om tjänsten använder myndighetens teknik för enkel inloggning och användarautentisering, så kallad single sign-on."
        }
    ]
}'

# =================================================
# UI CONFIGURATION
# =================================================
# Footer links configuration (JSON array format)
VITE_FOOTER_LINKS='[
    {
        "icon": "email",
        "text": "Mejla vår funktionsbrevlåda",
        "url": "mailto:designsystem@arbetsformedlingen.se"
    },
    {
        "text": "Arbetsförmedlingens designsystem (öppnas i egen flik)",
        "url": "https://designsystem.arbetsformedlingen.se/",
        "external": "true"
    }
]'

# Prefill requirements configuration (JSON array format)
# Allows pre-filling certain requirements based on organizational policies
VITE_PREFILL_REQUIREMENTS='[
    {
        "id": "1",
        "automatic": "false",
        "heading": "Valfri rubrik",
        "description": "Valfri beskrivningstext som förklarar för användaren vad förifyllnad innebär.",
        "activateText": "Text som visas i UI där användaren kan aktivera förifyllnad",
        "prefillRequirements": [
            {
                "ids": ["id1", "id2"],
                "status": "PASS",
                "comment": "Detta krav har förifyllts som godkänt eftersom ..."
            }
        ]
    },
    {
        "id": "2",
        "automatic": "true",
        "activateText": "",
        "prefillRequirements": [
            {
                "ids": ["id3","id4"],
                "status": "IRRELEVANT",
                "comment": "Detta krav har förifyllts som irrelevant eftersom ..."
            },
            {
                "ids": ["id5", "id6"],
                "status": "PASS",
                "comment": "Detta krav har förifyllts som godkänt eftersom ..."
            }
        ]
    }
]'

# =================================================
# LEGACY VARIABLES (No longer used after Oracle migration)
# =================================================
# These were used when the app connected to Supabase
# Keep commented out for reference during migration period
# VITE_DATABASE_URL="DATABASE_URL_HERE"
# VITE_DATABASE_KEY="DATABASE_KEY_HERE"

# =================================================
# NOTES
# =================================================
# - This file contains NO sensitive data (no passwords, no API keys)
# - All VITE_ variables are bundled into the frontend build and are PUBLIC
# - Never put secrets in VITE_ variables - they are visible in the browser
# - For backend/database config, see server/.env.example and root .env.example
