# Development Dockerfile for Frontend
# This image runs Vite dev server with Hot Module Replacement (HMR)

FROM registry.access.redhat.com/ubi8/nodejs-22@sha256:6e340dc525ab46e195fc01369ce44bdb36a3a04412bb96e05d463bcd451fccd8

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json ./

# Install dependencies
# Note: Using npm install instead of npm ci because this is part of a monorepo workspace
# and doesn't have its own package-lock.json
RUN npm install

# Copy configuration files
COPY vite.config.ts ./
COPY tsconfig.container.json ./tsconfig.json
COPY react-router.config.ts ./

# Copy source code and public assets
COPY app ./app
COPY public ./public

# Note: In development, app, public, and config files will be volume-mounted
# from compose.dev.yml, allowing hot-reload on file changes

# Expose Vite dev server port
EXPOSE 5173

# Start development server
# --host 0.0.0.0 allows connections from outside the container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
