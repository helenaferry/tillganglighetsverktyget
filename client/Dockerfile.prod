# Production Dockerfile for Frontend
# Multi-stage build: Build React app and serve with Nginx

# Stage 1: Build
FROM registry.access.redhat.com/ubi8/nodejs-22@sha256:6e340dc525ab46e195fc01369ce44bdb36a3a04412bb96e05d463bcd451fccd8 AS builder
USER root

# Set working directory
WORKDIR /app

# Använd .npmrc
COPY ./.npmrc .

# Kopiera allt i client-katalogen
COPY ./client .

# Kopiera in cert
COPY ./ca-bundle.crt ./ca-bundle.crt

# Install dependencies
# Note: Using npm install instead of npm ci because this is part of a monorepo workspace
# and doesn't have its own package-lock.json

ENV NODE_EXTRA_CA_CERTS=/app/ca-bundle.crt

RUN npm install --verbose

# Build production bundle

RUN npm run build

# Stage 2: Serve with Nginx
FROM registry.access.redhat.com/ubi9/nginx-124

# Copy custom nginx configuration
COPY ./client/nginx.conf /etc/nginx/nginx.conf

# Copy built files from builder stage
COPY --from=builder /app/build/client /usr/share/nginx/html

# Create nginx user and set up directories
RUN addgroup -g 101 -S nginx && \
    adduser -S -D -H -u 101 -h /var/cache/nginx -s /sbin/nologin -G nginx -g nginx nginx 2>/dev/null || true && \
    mkdir -p /var/cache/nginx /var/run/nginx && \
    chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/run/nginx && \
    chmod -R 755 /usr/share/nginx/html

# Switch to non-root user
USER nginx

# Expose port 8080 (non-privileged)
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
