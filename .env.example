# =================================================
# Tillgänglighetsverktyget - Container Orchestration
# =================================================
# PURPOSE: This file is used by Docker Compose to orchestrate all services
# USAGE: Copy to .env and set required passwords before running docker compose
# SCOPE: Container orchestration only - for service-specific config, see:
#   - server/.env.example (backend development)
#   - client/.env.example (frontend customization)

# =================================================
# PLATFORM CONFIGURATION
# =================================================

# Oracle Database Image Tag
# - ARM Mac (Apple Silicon): latest-lite (default, native ARM)
# - x64 systems (Windows/WSL, Intel Mac, Linux): latest
# Uncomment the line below if you're NOT on an ARM Mac:
# ORACLE_IMAGE_TAG=latest

# =================================================
# DATABASE CONFIGURATION (Oracle Container)
# =================================================

# Oracle Database System Password
# Used for the SYSTEM user in Oracle Database Free
# REQUIRED: Set a secure password (no default for security)
# NOTE: If your password contains $, escape it as $$ (e.g., Pass$word becomes Pass$$word)
ORACLE_PWD=

# Application Database User
DB_USER=tillgang_user
# REQUIRED: Set a secure password (no default for security)
# NOTE: If your password contains $, escape it as $$ (e.g., Pass$word becomes Pass$$word)
DB_PASSWORD=

# =================================================
# BACKEND CONFIGURATION (Backend Container)
# =================================================

NODE_ENV=development
BACKEND_PORT=3000

# CORS Configuration
# Comma-separated list of allowed origins
# Development: http://localhost:5173,http://localhost:3000
# Production: Set to your actual frontend domain(s)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =================================================
# FRONTEND CONFIGURATION (Frontend Container)
# =================================================

# API URL for frontend
# Development: http://localhost:3000/api (direct backend access)
# Production: /api (nginx proxies to backend container)
VITE_API_URL=http://localhost:3000/api

# Note: For additional frontend configuration (branding, logos, UI customization),
# see client/.env.example - copy it to client/.env.local and customize there

# =================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =================================================
# Before deploying to production:
# 1. ✅ Change all passwords to strong, unique values
# 2. ✅ Use secrets management (Docker secrets, Kubernetes secrets, HashiCorp Vault)
# 3. ✅ Set VITE_API_URL=/api (nginx will proxy to backend)
# 4. ✅ Update ALLOWED_ORIGINS to your production domain(s)
# 5. ✅ Enable HTTPS with proper SSL certificates
# 6. ✅ Set up backup procedures for oracle-data volume
# 7. ✅ Configure monitoring and health checks
# 8. ✅ Review and adjust resource limits in compose.prod.yml
