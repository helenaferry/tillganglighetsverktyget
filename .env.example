# =================================================
# Tillgänglighetsverktyget - Environment Variables
# =================================================
# Copy this file to .env and update with your values

# =================================================
# DATABASE CONFIGURATION
# =================================================

# Oracle Database System Password
# Used for the SYSTEM user in Oracle
# REQUIRED: Change this to a secure password
ORACLE_PWD=

# Application Database User
DB_USER=tillgang_user
# REQUIRED: Set a secure password (no default for security)
DB_PASSWORD=

# =================================================
# BACKEND CONFIGURATION
# =================================================

NODE_ENV=development
BACKEND_PORT=3000

# CORS Configuration
# Comma-separated list of allowed origins
# Development: http://localhost:5173,http://localhost:3000
# Production: Set to your actual frontend domain(s)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =================================================
# FRONTEND CONFIGURATION
# =================================================

# API URL for frontend
# Development: http://localhost:3000/api
# Production: /api (served through nginx reverse proxy)
VITE_API_URL=http://localhost:3000/api

# =================================================
# PRODUCTION NOTES
# =================================================
# For production deployment:
# 1. Change all passwords to strong, unique values
# 2. Use secrets management (e.g., Docker secrets, Kubernetes secrets)
# 3. Set VITE_API_URL=/api (nginx will proxy to backend)
# 4. Enable HTTPS with proper SSL certificates
# 5. Set up proper backup procedures for oracle-data volume
